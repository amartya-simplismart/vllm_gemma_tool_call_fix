+    /// Build a structural tag that accepts a schema-constrained message,
+    /// tool calls, or both — for requests that carry a `response_format` JSON
+    /// schema *and* tools.
+    ///
+    /// A bare JSON grammar accepts only the schema object, so a model that
+    /// starts a native tool call gets coerced into the JSON string and never
+    /// terminates. Constraining only the tool call instead would silently drop
+    /// the caller's schema. This emits one grammar covering every legitimate
+    /// shape:
+    ///
+    /// ```text
+    /// [ reasoning_prefix ] ( content_schema [ tool_calls ] | tool_calls )
+    /// ```
+    ///
+    /// `guided_decoding` accepts exactly one constraint, so the caller must
+    /// clear `json` when it sets this.
+    pub fn build_tool_call_format_with_content_schema(
+        &self,
+        ctx: &ToolCallFormatBuildContext<'_>,
+        content_schema: &Value,
+    ) -> anyhow::Result<Option<Value>> {
+        // Tool calls are mandatory inside their branch, so build the fragment
+        // with a forced tool choice; `Auto` would emit a triggered_tags node
+        // that also accepts arbitrary free text and lose the schema guarantee.
+        let forced_choice = match ctx.tool_choice {
+            ToolChoice::Named(name) => ToolChoice::Named(name.clone()),
+            _ => ToolChoice::Required,
+        };
+        let forced_ctx = ToolCallFormatBuildContext {
+            tool_choice: &forced_choice,
+            tools: ctx.tools,
+            parallel_tool_calls: ctx.parallel_tool_calls,
+            schema_mode: ctx.schema_mode,
+            // the reasoning prefix is applied once, around the whole union
+            starts_in_reasoning: false,
+        };
+
+        let Some(tool_calls) = (match self {
+            Self::TriggeredTags(config) => triggered_tags::build_triggered_tags(config, &forced_ctx)?,
+            Self::DsmlToolCalls(config) => dsml::build_dsml_tool_calls(config, &forced_ctx)?,
+        }) else {
+            return Ok(None);
+        };
+
+        let content = F::JsonSchema(JsonSchemaFormat {
+            json_schema: content_schema.clone(),
+            style: JsonSchemaStyle::Json,
+        });
+
+        let union = F::Or(OrFormat {
+            elements: vec![
+                // message, optionally followed by tool calls
+                F::Sequence(SequenceFormat {
+                    elements: vec![
+                        content,
+                        F::Optional(OptionalFormat {
+                            content: Box::new(tool_calls.format.clone()),
+                        }),
+                    ],
+                }),
+                // tool calls alone
+                tool_calls.format,
+            ],
+        });
+
+        let tag = self.wrap_union_reasoning_prefix(ctx, StructuralTag { format: union })?;
+        serde_json::to_value(tag).map(Some).map_err(Into::into)
+    }
+
+    /// Allow an optional leading reasoning block in front of the union.
+    ///
+    /// Both openings are accepted because the tag cannot see the prompt: the
+    /// model may open the block itself, or the chat template may have left the
+    /// prompt inside an already-open block so that only the closer is emitted.
+    fn wrap_union_reasoning_prefix(
+        &self,
+        ctx: &ToolCallFormatBuildContext<'_>,
+        suffix: StructuralTag,
+    ) -> anyhow::Result<StructuralTag> {
+        let Some(reasoning_end) = self.reasoning_end() else {
+            return Ok(suffix);
+        };
+
+        let close_only = F::Tag(TagFormat {
+            begin: String::new(),
+            content: Box::new(F::AnyText(AnyTextFormat { excludes: vec![] })),
+            end: reasoning_end.to_string(),
+        });
+
+        // A prompt that already opened the block can only emit the closer, so
+        // that branch is mandatory there; otherwise the block is optional.
+        let prefix = if ctx.starts_in_reasoning {
+            close_only
+        } else {
+            F::Optional(OptionalFormat {
+                content: Box::new(close_only),
+            })
+        };
+
+        Ok(StructuralTag {
+            format: F::Sequence(SequenceFormat {
+                elements: vec![prefix, suffix.format],
+            }),
+        })
+    }
