+    /// Build a union tag accepting the `response_format` schema, tool calls, or
+    /// both, for a non-forced tool choice that also constrains content.
+    ///
+    /// Returns `Ok(None)` when this does not apply — no tools, no JSON schema
+    /// to preserve, no tool-call parser, or a parser without a structural tag
+    /// builder — leaving the caller's existing behaviour untouched.
+    fn build_content_plus_tool_calls_tag(
+        &self,
+        request: &NvCreateChatCompletionRequest,
+        common_request: &PreprocessedRequest,
+        tool_choice: &ChatCompletionToolChoiceOption,
+        tools: &[ChatCompletionTool],
+        prompt_injected_reasoning: bool,
+    ) -> Result<Option<serde_json::Value>, DynamoError> {
+        if tools.is_empty() {
+            return Ok(None);
+        }
+
+        // Only a JSON-schema content constraint can be composed into a tag.
+        let Some(schema) = common_request
+            .sampling_options
+            .guided_decoding
+            .as_ref()
+            .and_then(|gd| gd.json.clone())
+        else {
+            return Ok(None);
+        };
+
+        let Some(parser_name) = self.tool_call_parser.as_deref() else {
+            return Ok(None);
+        };
+        let Some(builder) = Self::structural_tag_builder_for_parser(parser_name) else {
+            return Ok(None);
+        };
+
+        let converted_choice = convert_tool_choice(tool_choice);
+        let converted_tools = convert_tools(tools);
+        let ctx = ToolCallFormatBuildContext {
+            tool_choice: &converted_choice,
+            tools: &converted_tools,
+            parallel_tool_calls: request.inner.parallel_tool_calls,
+            schema_mode: self.runtime_config.structural_tag_schema,
+            starts_in_reasoning: prompt_injected_reasoning,
+        };
+
+        let tag = builder
+            .build_tool_call_format_with_content_schema(&ctx, &schema)
+            .map_err(|e| {
+                DynamoError::builder()
+                    .error_type(ErrorType::Unknown)
+                    .message(format!(
+                        "failed to build content+tool_calls structural tag for parser \
+                         '{parser_name}': {e}"
+                    ))
+                    .build()
+            })?;
+
+        if tag.is_some() {
+            tracing::debug!(
+                parser = parser_name,
+                "response_format + tools: replaced the JSON constraint with a \
+                 content-or-tool-calls structural tag"
+            );
+        }
+
+        Ok(tag)
+    }
 }
 
